# ─── Base de données PostgreSQL (Coolify) ───────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ─── MinIO (stockage d'images, Coolify) ─────────────────────────────────────
# URL interne (utilisée par Next.js côté serveur pour uploader)
MINIO_ENDPOINT="http://minio:9000"
# URL publique (utilisée pour afficher les images dans le navigateur)
MINIO_PUBLIC_URL="https://minio.votre-domaine.com"
MINIO_ACCESS_KEY="votre_access_key"
MINIO_SECRET_KEY="votre_secret_key"
MINIO_BUCKET="bnk2026"
MINIO_REGION="us-east-1"
